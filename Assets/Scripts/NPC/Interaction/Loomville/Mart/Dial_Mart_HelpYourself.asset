      npcId: mart
      targetTag: 
    choices: []
  - speakerName: Mart
    text: "Don't linger. Loomspire won't wait, and neither will I. Safe travels \u2014
      try not to waste the hardware."
    typeSpeed: 75
    soundEvent: {fileID: 11400000, guid: 0410f7133cabfcc46a12e20a38f8f44c, type: 2}
