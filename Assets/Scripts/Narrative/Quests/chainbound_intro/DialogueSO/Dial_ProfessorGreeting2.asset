      targetSource: 5
      npcId: 
      targetTag: 
  - speakerName: Prof Toby
    text: We don't always know where we're headed, we just know we're headed there
      fast!
    typeSpeed: 75
    soundEvent: {fileID: 11400000, guid: 0410f7133cabfcc46a12e20a38f8f44c, type: 2}
    portraitSprite: {fileID: 0}
