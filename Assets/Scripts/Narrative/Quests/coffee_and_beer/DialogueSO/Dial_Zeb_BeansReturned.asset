  m_Script: {fileID: 11500000, guid: 2f988bc0d55107749a911c0375bba164, type: 3}
  m_Name: Dial_Zeb_BeansReturned
  m_EditorClassIdentifier: 
  speakerNpcId: zeb
  playerFacingPolicy: 0
  lines:
  - speakerName: Zeb
    text: You got the bag back. I can't thank you enough.
    typeSpeed: 75
    soundEvent: {fileID: 11400000, guid: 0410f7133cabfcc46a12e20a38f8f44c, type: 2}
    portraitSprite: {fileID: 0}
    portraitTint: {r: 0, g: 0, b: 0, a: 0}
    camera:
      shotPreset: {fileID: 0}
      targetSource: 3
      npcId: zeb
      targetTag: 
    choices: []
  - speakerName: Zeb
    text: I'd finish the run myself, but the cart's wrecked and I've still got to
      gather what's left of the shipment.
    typeSpeed: 75
    soundEvent: {fileID: 11400000, guid: 0410f7133cabfcc46a12e20a38f8f44c, type: 2}
    portraitSprite: {fileID: 0}
    portraitTint: {r: 0, g: 0, b: 0, a: 0}
    camera:
      shotPreset: {fileID: 0}
      targetSource: 3
      npcId: zeb
      targetTag: 
    choices: []
  - speakerName: Zeb
    text: Take the beans to Reynard. He's the one who brews Toby's order.
    typeSpeed: 75
    soundEvent: {fileID: 11400000, guid: 0410f7133cabfcc46a12e20a38f8f44c, type: 2}
    portraitSprite: {fileID: 0}
    portraitTint: {r: 0, g: 0, b: 0, a: 0}
    camera:
      shotPreset: {fileID: 0}
      targetSource: 3
      npcId: zeb
      targetTag: 
    choices: []
  - speakerName: Zeb
    text: "When you find Momo, tell him I sent you. There's a cold beer waiting \u2014
      you earned it after a fight like that."
    typeSpeed: 75
    soundEvent: {fileID: 11400000, guid: 0410f7133cabfcc46a12e20a38f8f44c, type: 2}
    portraitSprite: {fileID: 0}
    portraitTint: {r: 0, g: 0, b: 0, a: 0}
    camera:
      shotPreset: {fileID: 0}
      targetSource: 3
      npcId: zeb
      targetTag: 
    choices: []
  autoAdvance: 0
  autoAdvanceDelay: 2
  allowSkip: 1
  skipToEndOfLine: 1
