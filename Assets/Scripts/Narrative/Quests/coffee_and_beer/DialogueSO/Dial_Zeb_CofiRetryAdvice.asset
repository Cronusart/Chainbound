      shotPreset: {fileID: 11400000, guid: e2e99b5b538b6914d99ce0ebfaca93f7, type: 2}
      targetSource: 3
      npcId: zeb
      targetTag: 
    choices: []
  - speakerName: Zeb
    text: Level your Chainlings up, and don't walk in alone. Bring a party.
    typeSpeed: 75
    soundEvent: {fileID: 11400000, guid: 0410f7133cabfcc46a12e20a38f8f44c, type: 2}
    portraitSprite: {fileID: 0}
    portraitTint: {r: 0, g: 0, b: 0, a: 0}
    camera:
      shotPreset: {fileID: 11400000, guid: e2e99b5b538b6914d99ce0ebfaca93f7, type: 2}
      targetSource: 3
      npcId: zeb
      targetTag: 
    choices: []
  - speakerName: Zeb
    text: When you're ready, I'll open the trail again.
    typeSpeed: 75
    soundEvent: {fileID: 11400000, guid: 0410f7133cabfcc46a12e20a38f8f44c, type: 2}
    portraitSprite: {fileID: 0}
    portraitTint: {r: 0, g: 0, b: 0, a: 0}
