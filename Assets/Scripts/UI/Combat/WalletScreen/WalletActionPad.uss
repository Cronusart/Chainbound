.wallet-screen {
    width: 320px;
    height: 180px;
    position: relative;
    background-color: rgba(0, 0, 0, 0);
}

.scanlines {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.42;
    z-index: 2;
}

.overlay {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 2px;
    bottom: 2px;
    z-index: 1;
    background-color: rgba(146, 169, 146, 0.2);
    background-image: url("project://database/Assets/Sprites/BattleDevice/Wallet_RT.png?fileID=2800000&guid=2484db45999de66439c95a3d4ef7c362&type=3#Wallet_RT");
    unity-background-scale-mode: stretch-to-fill;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(50, 66, 60, 0.9);
    border-right-color: rgba(50, 66, 60, 0.9);
    border-top-color: rgba(50, 66, 60, 0.9);
    border-bottom-color: rgba(50, 66, 60, 0.9);
}

.actions-row {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 3;
}

.action {
    position: absolute;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    min-width: 40px;
    min-height: 22px;
    background-color: rgba(95, 118, 101, 0.74);
    border-radius: 2px;
    transition-property: scale;
    transition-duration: 0.08s;
}

.action-label {
    color: rgb(45, 64, 61);
    -unity-font-style: bold;
    font-size: 18px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.selector {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(44, 62, 58);
    border-right-color: rgb(44, 62, 58);
    border-top-color: rgb(44, 62, 58);
    border-bottom-color: rgb(44, 62, 58);
    display: none;
    opacity: 1;
}

.action.is-selected {
    scale: 1.06;
}

.action.is-selected .selector {
    display: flex;
    opacity: 1;
}

.action.is-selected.blink-off .selector {
    opacity: 0;
}

.action.confirm .selector {
    border-left-color: rgb(255, 246, 188);
    border-right-color: rgb(255, 246, 188);
    border-top-color: rgb(255, 246, 188);
    border-bottom-color: rgb(255, 246, 188);
}

.action.is-disabled {
    opacity: 0.42;
}

.action.is-disabled .action-label {
    color: rgb(105, 54, 54);
}

.action--fight {
    left: 50%;
    top: 21%;
    translate: -50% -50%;
}

.action--flee {
    left: 19%;
    top: 50%;
    translate: -50% -50%;
}

.action--swap {
    left: 81%;
    top: 50%;
    translate: -50% -50%;
}

.action--item {
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    min-width: 48px;
}

.action--mint {
    left: 50%;
    top: 79%;
    translate: -50% -50%;
}
