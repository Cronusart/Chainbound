# Supabase Edge Functions
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# Optional Unity runtime override (also supported via Assets/StreamingAssets/Config.json)
CHAINBOUND_SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com

# Chainbound Core verification. REPLACE_* values are rejected at runtime;
# keep the Moves collection unset in the real secret store until it exists.
CHAINBOUND_SOLANA_CLUSTER=devnet
CHAINBOUND_GAME_PROGRAM_ID=9312ay7VrpvNYmyEx8TYCqhafbZ2Y5WGVbt6Qp772uUQ
CHAINBOUND_DAS_RPC_URL=https://api.devnet.solana.com
CHAINBOUND_CORE_MOVES_COLLECTION=REPLACE_WITH_CORE_COLLECTION_ADDRESS
CHAINBOUND_CORE_MOVES_UPDATE_AUTHORITY=FNRyxJLpcGuWwEUXYiXqjJMDsHAAs1gU8CnkjjBRL3ys
CHAINBOUND_CORE_COSMETICS_COLLECTION=REPLACE_WITH_CORE_COLLECTION_ADDRESS
CHAINBOUND_CORE_COSMETICS_UPDATE_AUTHORITIES=FNRyxJLpcGuWwEUXYiXqjJMDsHAAs1gU8CnkjjBRL3ys
CHAINBOUND_CORE_COVERS_COLLECTION=REPLACE_WITH_CORE_COLLECTION_ADDRESS
CHAINBOUND_CORE_ARCHIVES_COLLECTION=REPLACE_WITH_CORE_COLLECTION_ADDRESS

# Ownership Spine authority service (server-side only; never Unity assets,
# client builds, command literals, or logs). Functions fail closed when absent.
CHAINBOUND_RESULT_AUTHORITY_SECRET=REPLACE_IN_SERVER_SECRET_STORE
CHAINBOUND_OWNERSHIP_GENERATOR_VERSION=REPLACE_WITH_GENERATOR_VERSION
CHAINBOUND_OWNERSHIP_MODIFIER_POOL_HASH=REPLACE_WITH_32_BYTE_HEX_HASH
CHAINBOUND_OWNERSHIP_TICKET_TTL_SECONDS=REPLACE_WITH_TTL
CHAINBOUND_OWNERSHIP_STAMP_RAM_COST=75
CHAINBOUND_OWNERSHIP_BIND_RAM_COST=REPLACE_WITH_BIND_RAM_COST
CHAINBOUND_OWNERSHIP_SCHEMA_VERSION=1
CHAINBOUND_OWNERSHIP_METADATA_URI_BASE=REPLACE_WITH_HTTPS_METADATA_BASE

# Devnet operator smoke only. The prepare/confirm grant endpoints additionally
# require the authenticated active wallet and an approved beta-allowlist row.
CHAINBOUND_DEVNET_SMOKE_WALLETS=["REPLACE_WITH_DESKTOP_DEVNET_WALLET","REPLACE_WITH_SEEKER_DEVNET_WALLET"]
# Temporary deployment fallback; remove after every environment uses the plural setting.
CHAINBOUND_DEVNET_SMOKE_WALLET=REPLACE_WITH_EXACT_DEVNET_SMOKE_WALLET

# Immediate battle RAM rewards. Keep mode off until migrations, Edge, hosted
# BattleService, and closed-beta fixtures have all passed on Devnet. These are
# server secrets/config only and must never be bundled into Unity.
# Optional emergency restriction. Leave unset to defer to database battle_reward_settings.
# BATTLE_REWARD_MODE=off
BATTLE_REWARD_SERVICE_SECRET=REPLACE_IN_SERVER_SECRET_STORE
# Optional additional Edge restriction; the database UUID allowlist remains authoritative.
# BATTLE_REWARD_DEVNET_PROFILE_ALLOWLIST=["REPLACE_WITH_EXACT_PROFILE_UUID"]
BATTLE_REWARD_TIMEOUT_SECONDS=8
BATTLE_REWARDS_PATH=manifests/battle-rewards.json
# Optional BattleService override; defaults to ${SUPABASE_URL}/functions/v1/battle_reward_settle.
# BATTLE_REWARD_SETTLE_URL=https://REPLACE.supabase.co/functions/v1/battle_reward_settle
